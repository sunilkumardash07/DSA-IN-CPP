#include <iostream>
#include <vector>
using namespace std;
int main() {
	//How vectors work internally..???
	vector<int> v;//Empty Array
	v.push_back(5);//ek size ka aarray bn gya aur usme 5 hai
	cout<<v.size()<<" "<<v.capacity()<<endl;//size means how many elements but capacity means how many it can hold
	v.push_back(9);//double capacity ka array bna array size 2
	cout<<v.size()<<" "<<v.capacity()<<endl;
	v.push_back(10);//double capacity ka array bna array size 4
	cout<<v.size()<<" "<<v.capacity()<<endl;
	v.push_back(8);//8 usme jaa skta hai
	cout<<v.size()<<" "<<v.capacity()<<endl;
	v.push_back(7);//double capacity ka array bna array size 8
	cout<<v.size()<<" "<<v.capacity()<<endl;//size same hai but capacity jyada hai
	//size<=capacity
	v.push_back(34);
	cout<<v.size()<<" "<<v.capacity()<<endl;
	v.push_back(98);
	cout<<v.size()<<" "<<v.capacity()<<endl;
	v.push_back(50);
	cout<<v.size()<<" "<<v.capacity()<<endl<<endl;
	//Increase capacity by two times reduce the time complexity rather than increasing one by one.
	cout<<"Array: ";
	for(int i=0; i<v.size(); i++) {
		cout<<v[i]<<" ";
	}
	cout<<endl;

	v.pop_back();//size ghat gyi but capacity wahi same hai
	cout<<v.size()<<" "<<v.capacity()<<endl;
	v.pop_back();//size ghat gyi but capacity wahi same hai
	cout<<v.size()<<" "<<v.capacity()<<endl<<endl;
	cout<<"Array: ";
	for(int i=0; i<v.size(); i++) {
		cout<<v[i]<<" ";
	}


}
