#include <iostream>
using namespace std;
int main() {
	int n;
	cout<<"Enter Array Size: ";
	cin>>n;
	int arr[n];
	//Input
	for(int i=0; i<=n-1; i++) {
		cout<<"Enter The Number"<<"("<<i<<")= ";
		cin>>arr[i];
	}
	cout<<"Array Elements= ";
	for(int i=0; i<n; i++) {
		cout<<arr[i]<<", ";
	}
	cout<<endl<<endl;
	cout<<"Negative Elements= ";
	//Print The negative elements of Array
	for(int i=0; i<n; i++) {
		if(arr[i]<0) cout<<arr[i]<<" ";
	}

}
