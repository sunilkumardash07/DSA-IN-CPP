#include <iostream>
using namespace std;
int main() {
	//Ques. Give a point(x,y) write a program to find out if it lies in the 1st quadrant, 2nd Quadrant, 3rd Quadrant,4th Quadrant, on the x axis, y axis or at the origin.
	float x;
	float y;
	cout<<"Enter the x-coordinate= ";
    cin>>x;
	cout<<"Enter the y-coordinate= ";
    cin>>y;
    if(x==0 and y==0)cout<<"It lies at the origin";
    else if(x==0 and y!=0)cout<<"It lies on the y axis";
    else if(x!=0 and y==0)cout<<"It lies on the x axis ";
    else if(x>0 and y>0)cout<<"It lies in the First Quadrant";
    else if(x<0 and y<0)cout<<"It lies in the Third Quadrant";
    else if(x>0 and y<0)cout<<"It lies in the Fourth Quadrant";
    else if(x<0 and y>0)cout<<"It lies in the Second Quadrant";
    
    






}
