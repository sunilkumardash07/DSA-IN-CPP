#include <iostream>
using namespace std;
//Function Overloading(case-2)---->Datatypes of Parameters
void display( int x ) {
	cout<<"Integer= "<<x<<endl;
}
void display( double x ) {
	cout<<"Double= "<<x<<endl;
}
void display( char x ) {
	cout<<"Character= "<<x<<endl;
}
int main() {
	display('a');
	display(2.12);
	display(4.0);
	display(43);
}
