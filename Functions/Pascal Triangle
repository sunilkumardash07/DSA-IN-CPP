#include <iostream>
using namespace std;
//Ques.Pascal Triangle
//Space Trinagle + Triangle of Combination
int fact(int x) {
	int fact=1;
	for(int i=1; i<=x; i++) {
		fact*=i;
	}
	return fact;
}
int comb(int a, int b) {
	return fact(a)/(fact(b)*fact(a-b));
}



int main() {
	int n;
	cout<<"Enter The Number(n)= ";
	cin>>n;

	for(int i=0; i<=n; i++) {
		for(int j=0; j<=n-i; j++) {
			cout<<" ";
		}


		for(int j=0; j<=i; j++) {
			cout<<comb(i,j)<<" ";
		}
		cout<<endl;
	}



}
