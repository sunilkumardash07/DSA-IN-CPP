#include <iostream>
using namespace std;
//Ques. Take input n and r as input and print nCr and nPr
int fact(int x) {
	int fact=1;
	for(int i=1; i<=x; i++) {
		fact*=i;
	}
	return fact;
}
int main() {
	int n,r;
	cout<<"Enter The Number(n)= ";
	cin>>n;
	cout<<"Enter The Number(r)= ";
	cin>>r;

	int ncr=fact(n)/(fact(r)*fact(n-r));
	cout<<"Combination(nCr)= "<<ncr<<endl;

	int npr=fact(n)/fact(r);
	cout<<"Permutation(nPr)= "<<npr<<endl;




}
