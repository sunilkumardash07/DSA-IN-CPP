#include <iostream>
using namespace std;
int main() {
	//Alphabet Triangle Vertically Flipped
	int n;
	cout<<"Enter The Number= ";
	cin>>n;

	for(int i=1; i<=n; i++) {
		for(int j=1; j<=n-i; j++) {
			cout<<"  ";

		}

		for(int j=1; j<=i; j++) {
			cout<<(char)(j+64)<<" ";
		}
		cout<<endl;
	}



}
