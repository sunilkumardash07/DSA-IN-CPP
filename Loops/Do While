#include <iostream>

using namespace std;
int main() {
	//While Loop--> for Loop ka Replacement--> Self explanatory hai while loop
	for(int i=1; i<=10; i++) {
		cout<<i<<" ";

	}

	cout<<endl;

	int i=1;//Initialisation alag mein likha jayega
	while(i<=10) {
		cout<<i<<" ";
		i++;
	}

	cout<<endl;

	int x=1;
	while(x<=10) {
		cout<<"Hello"<<" ";
		x++;
	}
	cout<<endl;

	int y=1;
	for(; y<=20;) { //for loop mein ussi tarah likh skte hai lekin semi colon lgana mt bhulna
		cout<<y<<" ";
		y++;
	}







}
