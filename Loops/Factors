#include  <iostream>
#include <cmath>//required for sqrt in older versions
using namespace std;
int main() {
	int n;
	cout<<"Enter Number= ";
	cin>>n;
	cout<<"All the factors of The Number= ";
	for( int i=1; i<=n; i++) {
		if(n%i==0)cout<<i<<" ";


	}
cout<<endl;
	cout<<"All the factors of The Number= ";//we can reduce the no. of loops upto sqrt of the number as the factors upto sqrt is same at both the sides
	for(int i=1; i<=sqrt(n); i++) { // iterations reduced
		if(n%i==0)cout<<i<<" ";

		if(i!=n/i)cout<<n/i<<" ";









}
