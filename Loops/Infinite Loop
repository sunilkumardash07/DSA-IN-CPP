	    cout<<"Hello"<<" ";//Infinite times chlega
	i++;
	}
	while(1<2);

	while(false) { //0 or false ---> Then ye nhi chlega
		cout<<"Hello World"<<endl;
	}

	while(true) { //any nos except 0 and true---> Then ye infinnite times chlega
		cout<<"Hello World"<<endl;
	}




}
