#include <iostream>
#include <cmath>
using namespace std;
int main(){
    int n;
    cout<<"Enter The Number= ";
    cin>>n;
    int count=0;
    for(int i=1;i<=n;i++){
        if(n%i==0)count++;
        
    }
    cout<<"Number of Factors= ";
    cout<<count<<endl;
    bool x= false;//false means prime here
    for (int i =2; i<=sqrt(n); i++){
        if(n%i==0) x=true;
        break;
    }
    if (n==1)cout<<"Neither Prime nor Composite";
    else if(x==true)cout<<"Composite Number";
    else cout<<"Prime Number";
    
 
}   
