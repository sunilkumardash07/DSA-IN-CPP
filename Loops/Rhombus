#include <iostream>
using namespace std;
int main() {
	//Rhombus
	//Treat it as space horizontally flipped traingle+same no. of stars in every line(square loop)
	int n;
	cout<<"Enter The Number= ";
	cin>>n;

	for(int i=1; i<=n; i++) {
		for(int j=1; j<=n-i; j++) {
			cout<<"  ";

		}

		for(int j=1; j<=n; j++) {
			cout<<"* ";
		}
		cout<<endl;
	}



}
