#include <iostream>
using namespace std;
int main(){
    //Ques. Print sum of digits of Number
    int n;
    cout<<"Enter The Number= ";
    cin>>n;
    cout<<"Sum of The Digits= ";
    int sum=0;
    for(;n!=0;){
        int lastdigit=n%10;
        sum+=lastdigit;
        n/=10;
        
  }
    cout<<sum;
    
    
}
