#include <iostream>
using namespace std;
int main() {
	//Hollow Star Rectangle
	int m;
	cout<<"Enter The Number of Rows= ";
	cin>>m;
	int n;
	cout<<"Enter The Number of Columns= ";
	cin>>n;
	for(int i=1; i<=m; i++) {
		for(int j=1; j<=n; j++) {
			if(i==1||i==m||j==1||j==n)cout<<"*"<<" ";
			else cout<<"  ";//Any Thing can be printed inside it
		}
		cout<<endl;
	}




}
