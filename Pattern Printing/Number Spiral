#include <iostream>
using namespace std;
int main() {
	//Number Spiral

	int n;
	cout<<"Enter The Number= ";
	cin>>n;
	//METHOD-1
	//NUMBER SPIRAL MINIMUM SQUARE
	for(int i=1; i<=n; i++) {
		for(int j=1; j<=n; j++) {
			cout<<min(i,j)<<" ";
			// 			if(i>=j)cout<<j<<" ";
			// 			else cout<<i<<" ";
		}
		for(int j=n-1; j>=1; j--) {
			cout<<min(i,j)<<" ";
		}

		cout<<endl;

	}

	for(int i=n-1; i>=1; i--) {
		for(int j=1; j<=n; j++) {
			cout<<min(i,j)<<" ";
			// 			if(i>=j)cout<<j<<" ";
			// 			else cout<<i<<" ";
		}
		for(int j=n-1; j>=1; j--) {
			cout<<min(i,j)<<" ";
		}

		cout<<endl;

	}
	cout<<endl<<endl;
	//METHOD-2
	//UPTO 2*N-1 USING FAKE/DUMMY VARIABLES
	// a+i=2n;b+j=2n

	for(int i=1; i<=2*n-1; i++) {
		for(int j=1; j<=2*n-1; j++) {
			int a=i, b=j;
			if(i>n) a=2*n-i;
			if(b>n) b=2*n-j;

			cout<<min(a,b)<<" ";
		}
		cout<<endl;
	}




}
