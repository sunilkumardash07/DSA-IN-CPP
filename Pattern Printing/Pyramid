#include <iostream>
using namespace std;
int main() {
	//Pyramid
	//Space Horizontally flipped Triangle+ odd Triangle

	int n;
	cout<<"Enter The Number= ";
	cin>>n;

	for(int i=1; i<=n; i++) {
		for(int j=1; j<=n-i; j++) {
			cout<<"  ";

		}
		for(int j=1; j<=2*i-1; j++) {
			cout<<"* ";
		}
		cout<<endl;
	}
}
