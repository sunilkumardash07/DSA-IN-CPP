#include <iostream>
using namespace std;
int main() {
	//Star Cross

	int n;
	cout<<"Enter The Number(only ODD)= ";
	cin>>n;
	if(n%2==0)cout<<"Not Possible";
	else
		for(int i=1; i<=n; i++) {
			for(int j=1; j<=n; j++) {
				if(j==i||i+j==n+1)cout<<"*"<<" ";
				else cout<<"  ";
			}
			cout<<endl;
		}




}
