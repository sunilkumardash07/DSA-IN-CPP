#include <iostream>
using namespace std;
int main() {
	//PATTERN PRINTING--->>NESTED LOOPS...
	//STAR RECTANGLE(rows*  columns)
	cout<<"******"<<endl;
	cout<<"******"<<endl;
	cout<<"******"<<endl<<endl;//3 rows 6 columns
	//Majdoori

	char x='*';
	for(int i=1; i<=4; i++) {
		cout<<x<<x<<x<<x<<x<<endl;//4 rows 5 columns
	}//aur ek majdoori
	cout<<endl;

	for(int i=1; i<=3; i++) {
		cout<<"****"<<endl;//3 rpws 4 columns
	}//Majdoori
	cout<<endl;

	for(int i=1; i<=3; i++) {
		for(int j=1; j<=8; j++) {
			cout<<"*";//3 rows 8 columns
		}//Best Method
		cout<<endl;
	}


}
