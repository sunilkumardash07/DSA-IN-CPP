#include <iostream>
using namespace std;
int main() {
	//Star triangle Vertically Flipped Method-1
	//Treat it as a square
	int n;
	cout<<"Enter The Number= ";
	cin>>n;

	for(int i=1; i<=n; i++) {
		for(int j=1; j<=n; j++) {
			if((i+j)>=n+1)cout<<"* ";
			else cout<<"  ";
		}
		cout<<endl;
	}



}
