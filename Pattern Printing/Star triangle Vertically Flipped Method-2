#include <iostream>
using namespace std;
int main() {
	//Star triangle Vertically Flipped Method-2
	//Space triangle Horizontally Flipped(space loop) + Star Triangle(star loop)
	int n;
	cout<<"Enter The Number= ";
	cin>>n;

	for(int i=1; i<=n; i++) {
		for(int j=1; j<=n-i; j++) {
			cout<<"  ";
		}
		for(int j=1; j<=i; j++) {
			cout<<"* ";
		}
		cout<<endl;

	}



}
