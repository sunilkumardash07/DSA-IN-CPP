#include <iostream>
using namespace std;
//Count Of Digits
void countDigit(int n, int* p){
    int count = (n==0) ? 1 : 0;
    while(n!=0){
        count++;
        n/=10;
    }
    *p= count;
    
}

int main() {
	int n;
	cout<<"Enter The Number= ";
	cin>>n;
	int c=0;
	countDigit(n, &c);
	cout<<"Number Of Digits= "<<c<<endl;
	
}
