#include <iostream>
using namespace std;
//Dereference Operator
int main() {
	int x=79;
	int* ptr=&x;//Address Store
	cout<<ptr<<endl;//Address of int x
	cout<<&ptr<<endl;//Address of ptr
	cout<<*ptr<<endl;//Star is a Dereference Operator--->Address pe jaake value
	
	cout<<x<<endl;
	*ptr=70;//Address pe jaake value Changed
	cout<<x<<endl;
	
	*ptr+=30;
	cout<<x<<endl;
	
	*ptr*=10;
	cout<<x<<endl;
	
}
