#include <iostream>
using namespace std;
int main() {
    int x=7;
    int y=7;
    cout<<&x<<endl;
    cout<<&y<<endl;
    //value same but different variable so different address
    int* p1=&x;
    int* p2=&x;
     cout<<p1<<endl;
    cout<<p2<<endl;
    //same 
     cout<<&p1<<endl;//Address of p1
    cout<<&p2<<endl;//Address of p2
}
